-- Queries used for Tableau Project Covid_Viz
-- Using MySQL

-- 1. 

SELECT 
	SUM(new_cases) as total_cases, 
	SUM(new_deaths) as total_deaths, 
    SUM(new_deaths)/SUM(New_Cases)*100 as mortality_rate
FROM covid_deaths
#WHERE country LIKE '%philippines%'#
WHERE continent IS NOT NULL
ORDER BY 1,2
;

SELECT
	date,
	SUM(new_cases) as total_cases, 
	SUM(new_deaths) as total_deaths, 
    SUM(new_deaths)/SUM(New_Cases)*100 as mortality_rate
FROM covid_deaths
GROUP BY date
ORDER BY 1,2
;

-- 2. 

-- Certain rows (categories) were taken out as they are not inluded in the above queries to stay consistent

SELECT 
	country,
    SUM(new_deaths) as total_deaths
FROM covid_deaths
WHERE continent IS NULL
AND country NOT IN ('World', 'European Union (27)', 'International', 'World excl. China','World excl. China and South Korea', 'World excl. China, South Korea, Japan and Singapore', 
'Asia excl. China', 'High-income countries', 'Upper-middle-income countries', 'Lower-middle-income countries', 'Low-income countries')
GROUP BY country
HAVING SUM(new_deaths) > 0
ORDER BY SUM(new_deaths) DESC
;


-- 3.

SELECT
	country,
    population,
    MAX(total_cases) AS highest_infection_count,
    MAX(total_cases/population)*100 as percent_population_infected
FROM covid_deaths
GROUP BY country, population
ORDER BY MAX(total_cases/population)*100 DESC
;



-- 4.

SELECT
	country,
    population,
    date,
    MAX(total_cases) as highest_infection_count,
	MAX(total_cases/population)*100 as percent_population_infected
FROM covid_deaths
GROUP BY country, population, date
ORDER BY MAX(total_cases/population)*100 DESC
;
